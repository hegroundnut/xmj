/* ===== Page ===== */
.page { background: #fff; min-height: 100vh; position: relative; }

/* ===== Nav Bar (fixed top) ===== */
.nav-bar { display: flex; align-items: center; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 20rpx; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(0,0,0,0.04); }
.nav-back-icon { font-size: 40rpx; color: #1A1A1A; font-weight: 300; line-height: 1; }

/* ===== Content area ===== */
.content-area { padding-bottom: 180rpx; }

/* ===== Hero (centered in content) ===== */
.course-hero { width: 100%; height: 440rpx; background: #F0EFED; position: relative; margin-top: 0; }
.hero-bg { width: 100%; height: 100%; }
.hero-placeholder { width: 100%; height: 100%; background: #F0EFED; }
.hero-tag { position: absolute; top: 32rpx; left: 32rpx; background: #1A1A1A; color: #fff; font-size: 20rpx; padding: 8rpx 28rpx; border-radius: 24rpx; letter-spacing: 2rpx; }
.hero-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; }
.hero-play-icon { font-size: 40rpx; color: #1A1A1A; margin-left: 4rpx; }

/* ===== Info section ===== */
.info-section { padding: 40rpx; }
.info-title { font-size: 40rpx; font-weight: 300; color: #1A1A1A; letter-spacing: 4rpx; line-height: 1.4; display: block; margin-bottom: 20rpx; }
.info-sub { font-size: 24rpx; color: rgba(0,0,0,0.35); line-height: 1.6; font-weight: 300; display: block; }

/* ===== Divider ===== */
.divider { height: 1px; background: rgba(0,0,0,0.04); margin: 0 40rpx; }

/* ===== Curriculum ===== */
.curriculum-section { padding: 40rpx; }
.section-title { font-size: 22rpx; letter-spacing: 6rpx; color: rgba(0,0,0,0.3); display: block; margin-bottom: 32rpx; font-weight: 400; }
.lesson-item { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1px solid rgba(0,0,0,0.04); gap: 28rpx; }
.lesson-item:last-child { border-bottom: none; }
.lesson-num { width: 48rpx; height: 48rpx; border-radius: 50%; background: #FAFAF8; border: 1px solid rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: rgba(0,0,0,0.35); flex-shrink: 0; font-weight: 300; }
.lesson-info { flex: 1; }
.lesson-name { font-size: 26rpx; font-weight: 400; color: #1A1A1A; letter-spacing: 1rpx; display: block; }
.lesson-duration { font-size: 22rpx; color: rgba(0,0,0,0.25); font-weight: 300; display: block; margin-top: 4rpx; }
.lesson-free { font-size: 20rpx; color: #1A1A1A; background: #FAFAF8; border: 1px solid rgba(0,0,0,0.06); padding: 4rpx 20rpx; border-radius: 20rpx; letter-spacing: 1rpx; }
.lesson-lock { font-size: 22rpx; color: rgba(0,0,0,0.25); }

/* ===== Reviews ===== */
.review-section { padding: 40rpx; }
.review-item { padding: 28rpx; background: #FAFAF8; border: 1px solid rgba(0,0,0,0.04); border-radius: 16rpx; margin-bottom: 20rpx; }
.review-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.review-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #EBE9E6; flex-shrink: 0; }
.review-name { font-size: 24rpx; font-weight: 400; color: #1A1A1A; flex: 1; }
.review-stars { font-size: 20rpx; color: rgba(0,0,0,0.3); letter-spacing: 4rpx; }
.review-text { font-size: 24rpx; color: rgba(0,0,0,0.45); line-height: 1.6; font-weight: 300; display: block; }

/* ===== Bottom bar ===== */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; height: 160rpx; padding: 0 40rpx 56rpx; display: flex; align-items: center; gap: 24rpx; background: rgba(255,255,255,0.95); border-top: 1px solid rgba(0,0,0,0.04); z-index: 100; }
.bottom-action { display: flex; flex-direction: column; align-items: center; gap: 4rpx; width: 100rpx; }
.bottom-action-svg { width: 32rpx; height: 32rpx; opacity: 0.3; }
.bottom-action-svg.active { opacity: 1; }
.action-label { font-size: 20rpx; color: rgba(0,0,0,0.3); font-weight: 300; }
.buy-btn { flex: 1; padding: 28rpx; background: #1A1A1A; color: #fff; border: none; border-radius: 48rpx; font-size: 28rpx; font-weight: 400; letter-spacing: 2rpx; line-height: 1.2; }

/* ===== State ===== */
.state-box { display: flex; align-items: center; justify-content: center; height: 100vh; }
.state-text { font-size: 28rpx; color: rgba(0,0,0,0.3); font-weight: 300; }

/* ===== QR Modal ===== */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 200; display: none; align-items: center; justify-content: center; }
.modal-overlay.show { display: flex; animation: modalFadeIn 0.3s ease; }
@keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal-card { background: #fff; border-radius: 32rpx; padding: 56rpx 48rpx 48rpx; width: 560rpx; text-align: center; position: relative; animation: modalSlideUp 0.35s ease; }
@keyframes modalSlideUp { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: translateY(0); } }
.modal-close { position: absolute; top: 24rpx; right: 28rpx; width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: rgba(0,0,0,0.3); line-height: 1; }
.modal-label { font-size: 18rpx; letter-spacing: 6rpx; color: #6B764F; text-transform: uppercase; opacity: 0.5; margin-bottom: 12rpx; display: block; }
.modal-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 28rpx; letter-spacing: 2rpx; display: block; }
.modal-qr { width: 320rpx; height: 320rpx; margin: 0 auto 28rpx; border-radius: 20rpx; border: 2rpx solid rgba(0,0,0,0.06); overflow: hidden; background: #FAFAF8; }
.modal-qr-img { width: 100%; height: 100%; }
.modal-qr-loading { font-size: 24rpx; color: rgba(0,0,0,0.25); display: flex; align-items: center; justify-content: center; height: 100%; }
.modal-desc { font-size: 22rpx; color: rgba(0,0,0,0.4); line-height: 1.6; letter-spacing: 0.6rpx; font-weight: 300; white-space: pre-line; display: block; }
.modal-strong { color: #6B764F; font-weight: 500; }
.modal-hint { margin-top: 20rpx; font-size: 20rpx; color: rgba(0,0,0,0.25); letter-spacing: 1rpx; display: block; }

/* ===== Video modal ===== */
.video-modal { position: fixed; inset: 0; background: #000; z-index: 999; display: flex; align-items: center; justify-content: center; }
.video-close { position: absolute; right: 40rpx; width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; z-index: 1000; }
.video-player { width: 100%; height: 460rpx; background: #000; }
.video-error { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60rpx; }
.video-error-icon { font-size: 96rpx; color: #E0A030; margin-bottom: 32rpx; }
.video-error-title { font-size: 34rpx; color: #fff; font-weight: 500; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.video-error-desc { font-size: 26rpx; color: rgba(255,255,255,0.6); letter-spacing: 1rpx; margin-bottom: 48rpx; }
.video-error-btn { padding: 20rpx 64rpx; background: #6B764F; color: #F0EBE0; border-radius: 44rpx; font-size: 28rpx; letter-spacing: 4rpx; }

/* ===== Course images (type=2) ===== */
.course-images-section { padding: 40rpx; }
.course-photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.course-photo-item { width: calc((100% - 24rpx) / 3); height: 210rpx; border-radius: 8rpx; background: #F0EFED; }
