/* ===== Page ===== */
.page { background: #F8F7F5; min-height: 100vh; position: relative; overflow-x: hidden; }

/* ===== Page header ===== */
.page-header { padding: 16rpx 48rpx 28rpx; background: linear-gradient(180deg, #E8DDD3 0%, #EDE4DA 40%, #F3ECE5 70%, #F8F7F5 100%); }
.page-title { font-size: 52rpx; font-weight: 300; color: #1A1A1A; letter-spacing: 6rpx; animation: titleFadeIn 0.8s ease-out 0.6s both; }

.wm-wrap { position: relative; height: 100rpx; overflow: hidden; margin-bottom: 8rpx; }
.wm { position: absolute; opacity: 0; }
.wm-ali { font-size: 56rpx; font-weight: 700; color: rgba(255,255,255,0.35); letter-spacing: 6rpx; top: 4rpx; left: -10rpx; text-shadow: 0 0 20rpx rgba(255,255,255,0.08); transform: rotate(-8deg); animation: wmFadeIn 0.7s ease-out 0.1s forwards; }
.wm-studio { font-size: 40rpx; font-weight: 700; color: rgba(255,255,255,0.25); letter-spacing: 4rpx; top: 36rpx; left: 180rpx; text-shadow: 0 0 16rpx rgba(255,255,255,0.06); transform: rotate(5deg); animation: wmFadeIn 0.7s ease-out 0.3s forwards; }
.wm-brow { font-size: 64rpx; font-weight: 300; color: rgba(255,255,255,0.3); letter-spacing: 8rpx; top: 16rpx; left: 360rpx; text-shadow: 0 0 20rpx rgba(255,255,255,0.08); transform: rotate(-3deg); animation: wmFadeIn 0.7s ease-out 0.5s forwards; }

@keyframes wmFadeIn {
  from { opacity: 0; transform: translateY(24rpx) rotate(0deg); }
  to { opacity: 1; transform: translateY(0) rotate(-8deg); }
}
@keyframes titleFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== Type tabs ===== */
.tabs { display: flex; padding: 0 40rpx 24rpx; gap: 24rpx; }
.tab-pill { display: inline-flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 16rpx 40rpx; border-radius: 28rpx; background: transparent; }
.tab-pill .en { font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; color: rgba(0,0,0,0.22); }
.tab-pill .cn { font-size: 28rpx; font-weight: 400; color: rgba(0,0,0,0.35); }
.tab-pill.active { background: #1A1A1A; }
.tab-pill.active .en { color: rgba(255,255,255,0.5); font-weight: 500; }
.tab-pill.active .cn { color: #fff; font-weight: 500; }

/* ===== Category bar ===== */
.cat-bar { padding: 0 40rpx 28rpx; white-space: nowrap; }
.cat-inner { display: inline-flex; gap: 16rpx; }
.cat-tag { display: inline-block; padding: 10rpx 28rpx; border-radius: 28rpx; font-size: 22rpx; color: rgba(0,0,0,0.35); background: rgba(0,0,0,0.03); font-weight: 400; letter-spacing: 1rpx; flex-shrink: 0; }
.cat-tag.active { color: #fff; background: #1A1A1A; font-weight: 500; }

/* ===== Case grid ===== */
.case-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 40rpx 0; }
.case-card { width: 49%; margin-bottom: 20rpx; border-radius: 20rpx; overflow: hidden; background: #fff; border: 2rpx solid rgba(0,0,0,0.03); }
.case-card:active { transform: scale(0.97); }

.card-thumb { width: 100%; height: 340rpx; overflow: hidden; background: #EDEBE8; position: relative; }
.thumb-img { width: 100%; height: 100%; }
.thumb-placeholder { width: 100%; height: 100%; background: #EDEBE8; }
.thumb-tag { position: absolute; top: 16rpx; left: 16rpx; background: rgba(0,0,0,0.6); color: #fff; font-size: 18rpx; font-weight: 500; padding: 6rpx 18rpx; border-radius: 20rpx; letter-spacing: 1rpx; }

.badge-video { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1); }
.play-icon-svg { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

/* ===== 游客试看水印 ===== */
.trial-wm { position: absolute; inset: 0; pointer-events: none; background-repeat: repeat; background-size: 160rpx 130rpx; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='150'%20height='120'%3E%3Ctext%20x='75'%20y='66'%20font-size='26'%20font-weight='600'%20fill='rgba(255,255,255,0.45)'%20stroke='rgba(0,0,0,0.15)'%20stroke-width='1'%20text-anchor='middle'%20transform='rotate(-18%2075%2060)'%3EALILAOXI%3C/text%3E%3C/svg%3E"); }

.card-info { padding: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.card-name { font-size: 24rpx; font-weight: 400; color: #1A1A1A; letter-spacing: 1rpx; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-action { display: flex; align-items: center; padding: 8rpx; flex-shrink: 0; }
.action-svg { width: 28rpx; height: 28rpx; opacity: 0.3; }
.action-svg.active { opacity: 1; }

/* ===== Empty ===== */
.empty-case { width: 100%; text-align: center; padding: 120rpx 40rpx; color: rgba(0,0,0,0.2); font-size: 28rpx; }

/* ===== State ===== */
.state-box { display: flex; align-items: center; justify-content: center; height: 100vh; }
.state-text { font-size: 28rpx; color: rgba(0,0,0,0.3); font-weight: 300; }
