<view class="page">
  <!-- States -->
  <view class="state-box" wx:if="{{loading}}"><text class="state-text">加载中...</text></view>
  <view class="state-box" wx:elif="{{error}}" bindtap="loadData"><text class="state-text">加载失败，点击重试</text></view>

  <block wx:if="{{!loading && !error}}">
    <!-- Hero swiper -->
    <view class="hero">
      <swiper bindchange="onSwiperChange" indicator-dots="{{false}}" class="hero-swiper" autoplay="{{true}}" interval="{{4000}}" circular="{{true}}" wx:if="{{banners.length}}">
        <swiper-item wx:for="{{banners}}" wx:key="*this" bindtap="onPreviewBanner">
          <image src="{{item.image || ''}}" mode="aspectFill" class="hero-img" wx:if="{{item.image}}"/>
          <view class="hero-overlay" style="background:{{item.bg || 'linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 100%)'}}"/>
        </swiper-item>
      </swiper>
      <!-- Hero text overlay -->
      <view class="hero-text" wx:if="{{banners.length}}">
        <text class="hero-brand">{{heroText.brand || 'ALI LAOXI'}}</text>
        <text class="hero-title">{{heroText.title || '阿利老西'}}</text>
        <text class="hero-sub">{{heroText.subtitle || '专业设备 · 第5代新品'}}</text>
      </view>
      <!-- Hero dots -->
      <view class="hero-dots" wx:if="{{banners.length > 1}}">
        <view class="dot {{currentSlide === index ? 'active' : ''}}" wx:for="{{banners}}" wx:key="*this"/>
      </view>
      <!-- Hero placeholder when no banners -->
      <view class="hero-placeholder" wx:if="{{!banners.length}}">
        <view class="hero-overlay"/>
        <view class="hero-text">
          <text class="hero-brand">{{heroText.brand || 'ALI LAOXI'}}</text>
          <text class="hero-title">{{heroText.title || '阿利老西'}}</text>
          <text class="hero-sub">{{heroText.subtitle || '专业设备 · 第5代新品'}}</text>
        </view>
      </view>
    </view>

    <!-- Products section -->
    <view class="section" wx:if="{{products.length}}">
      <view class="section-header">
        <view class="section-title-group">
          <text class="section-title">产品中心</text>
          <text class="section-title-en">PRODUCTS</text>
        </view>
        <text class="section-more" bindtap="onMoreProducts">查看全部 ›</text>
      </view>
      <scroll-view scroll-x class="products-scroll">
        <view class="products-inner">
          <view class="prod-card" wx:for="{{products}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
            <view class="prod-thumb">
              <image src="{{item.image || item.thumb || ''}}" mode="aspectFill" class="prod-thumb-img"/>
            </view>
            <view class="prod-info">
              <text class="prod-name">{{item.name || item.title}}</text>
              <text class="prod-sub">{{item.subtitle || item.desc || ''}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Cases section -->
    <view class="section" wx:if="{{cases.length}}">
      <view class="section-header">
        <view class="section-title-group">
          <text class="section-title">{{casesTitle}}</text>
          <text class="section-title-en">SELECTED CASES</text>
        </view>
        <text class="section-more" bindtap="onMoreCases">查看全部 ›</text>
      </view>
      <scroll-view scroll-x class="cases-scroll">
        <view class="cases-inner">
          <view class="case-card" wx:for="{{cases}}" wx:key="id" bindtap="onCaseTap" data-id="{{item.id}}">
            <view class="case-img" style="background:{{item.bg || 'linear-gradient(135deg, #C8BFB4, #A89E93)'}};">
              <image src="{{item.cover || ''}}" mode="aspectFill" class="case-thumb" wx:if="{{item.cover}}"/>
            </view>
            <text class="case-tag {{item.is_new ? 'new' : ''}}">{{item.category_name || '对比'}}</text>
            <view class="case-info">
              <text class="case-name">{{item.title}}</text>
              <text class="case-meta">{{item.category_name}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Courses section -->
    <view class="section" wx:if="{{courses.length}}">
      <view class="section-header">
        <view class="section-title-group">
          <text class="section-title">{{coursesTitle}}</text>
          <text class="section-title-en">HOT COURSES</text>
        </view>
        <text class="section-more" bindtap="onMoreCourses">查看全部 ›</text>
      </view>
      <view>
        <view class="course-item" wx:for="{{courses}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}">
          <view class="course-thumb" style="background:{{item.bg || '#F0EFED'}};">
            <image src="{{item.cover || ''}}" mode="aspectFill" class="course-thumb-img" wx:if="{{item.cover}}"/>
            <text class="course-badge">{{item.category_name || '入门'}}</text>
          </view>
          <view class="course-info">
            <text class="course-name">{{item.title}}</text>
            <text class="course-desc">{{item.desc || ''}}</text>
            <view class="course-price-row">
              <text class="course-level-tag {{item.member_level === 2 ? 'super' : 'regular'}}">{{item.member_level_text || (item.member_level === 2 ? '超级会员' : '普通会员')}}</text>
              <view class="course-add" bindtap="onCourseTap" data-id="{{item.id}}">学习</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Contact section -->
    <view class="section" wx:if="{{contact}}">
      <view class="section-header">
        <view class="section-title-group">
          <text class="section-title">联系我们</text>
          <text class="section-title-en">CONTACT US</text>
        </view>
      </view>
      <view class="contact-card">
        <view class="contact-row">
          <image src="/static/svg/contact-phone.svg" class="contact-icon-svg"/>
          <view class="contact-info">
            <text class="contact-text">{{contact.phone || '400-888-9999'}}</text>
            <text class="contact-label">客服热线</text>
          </view>
          <view class="contact-actions">
            <view class="contact-btn primary" catchtap="onCallPhone">拨打</view>
            <view class="contact-btn" catchtap="onCopyPhone">复制</view>
          </view>
        </view>
        <view class="contact-row">
          <image src="/static/svg/contact-wechat.svg" class="contact-icon-svg"/>
          <view class="contact-info">
            <text class="contact-text">微信号: {{contact.wechat || 'alilaoxi_official'}}</text>
            <text class="contact-label">微信客服</text>
          </view>
          <view class="contact-actions">
            <view class="contact-btn" catchtap="onCopyWechat">复制</view>
          </view>
        </view>
        <view class="contact-row">
          <image src="/static/svg/contact-clock.svg" class="contact-icon-svg"/>
          <view>
            <text class="contact-text">{{contact.hours || '周一至周六 10:00-19:30'}}</text>
            <text class="contact-label">营业时间</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom spacer for tab bar -->
    <view class="bottom-spacer"/>
  </block>

  <!-- 会员门槛弹窗（拦截非会员进入课程） -->
  <view class="modal-overlay show" wx:if="{{showGateQR}}">
    <view class="modal-card">
      <text class="modal-label">ALI LAOXI MEMBER</text>
      <text class="modal-title">会员专属课程</text>
      <view class="modal-qr">
        <image src="{{qrCode}}" mode="aspectFit" class="modal-qr-img" wx:if="{{qrCode}}"/>
        <text class="modal-qr-loading" wx:else>加载中…</text>
      </view>
      <text class="modal-desc">开通会员后免费观看全部课程\n扫码添加客服开通</text>
      <view class="modal-save-btn" bindtap="onSaveQR">
        <text>保存二维码</text>
      </view>
      <view class="modal-back-btn" bindtap="onCloseGateQR">
        <text>返回</text>
      </view>
    </view>
  </view>
</view>
