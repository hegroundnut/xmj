/* ===== Page ===== */
.page { background: #fff; min-height: 100vh; }

/* ===== Nav bar ===== */
.nav-bar { display: flex; align-items: center; justify-content: space-between; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 28rpx; }
.nav-back { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FAFAF8; display: flex; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 36rpx; color: #1A1A1A; font-weight: 300; line-height: 1; }
.nav-title { font-size: 30rpx; font-weight: 400; color: #1A1A1A; letter-spacing: 4rpx; }
.nav-right { width: 64rpx; }

/* ===== States ===== */
.state-box { display: flex; align-items: center; justify-content: center; padding: 200rpx 40rpx; }
.state-text { font-size: 28rpx; color: rgba(0,0,0,0.3); font-weight: 300; }
.empty-hint { text-align: center; padding: 200rpx 40rpx; color: rgba(0,0,0,0.2); font-size: 26rpx; font-weight: 300; }

/* ===== Course list (same style as favorites) ===== */
.course-list { padding: 0 40rpx 80rpx; }
.section-count { font-size: 22rpx; color: rgba(0,0,0,0.25); padding: 24rpx 0 16rpx; display: block; letter-spacing: 1rpx; }
.fav-card { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1px solid rgba(0,0,0,0.04); }
.fav-card:last-child { border-bottom: none; }
.fav-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #F5F4F2; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.thumb-img { width: 100%; height: 100%; }
.thumb-icon { font-size: 44rpx; }
.fav-body { flex: 1; min-width: 0; }
.fav-title { font-size: 26rpx; color: #1A1A1A; font-weight: 400; letter-spacing: 1rpx; display: block; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fav-meta { display: flex; align-items: center; gap: 16rpx; }
.fav-tag { font-size: 20rpx; color: #6B764F; background: rgba(107,118,79,0.08); padding: 2rpx 12rpx; border-radius: 10rpx; }
.fav-date { font-size: 20rpx; color: rgba(0,0,0,0.25); }
.course-arrow { font-size: 28rpx; color: rgba(0,0,0,0.15); flex-shrink: 0; }
