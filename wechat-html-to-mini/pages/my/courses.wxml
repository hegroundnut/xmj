<view class="page">
  <!-- Nav bar -->
  <view class="nav-bar" style="padding-top: {{navHeight}}px;">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">我的课程</text>
    <view class="nav-right"/>
  </view>

  <!-- States -->
  <view class="state-box" wx:if="{{loading}}">
    <text class="state-text">加载中...</text>
  </view>
  <view class="empty-hint" wx:elif="{{!loading && list.length === 0}}">
    <text>暂无收藏课程</text>
  </view>

  <!-- Course list -->
  <view class="course-list" wx:else>
    <text class="section-count">共 {{list.length}} 门课程</text>
    <view class="fav-card" wx:for="{{list}}" wx:key="id" bindtap="onTap" data-id="{{item.id}}">
      <view class="fav-thumb">
        <text class="thumb-icon" wx:if="{{!item.cover && !item.thumb}}">🎬</text>
        <image src="{{item.cover || item.thumb}}" mode="aspectFill" class="thumb-img" wx:else/>
      </view>
      <view class="fav-body">
        <text class="fav-title">{{item.title || item.name || '课程'}}</text>
        <view class="fav-meta">
          <text class="fav-tag">课程</text>
          <text class="fav-date">{{item.add_time || ''}}</text>
        </view>
      </view>
      <text class="course-arrow">›</text>
    </view>
  </view>
</view>
